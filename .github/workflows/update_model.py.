import json
import os

def generate_data():
    analyzed_matches = [
        {
            "match": "Atalanta vs Roma",
            "date": "2026-08-15",
            "home_team": "Atalanta",
            "away_team": "Roma",
            "combined_xg": 3.25,
            "over_25_probability": 0.68,
            "market_signal": "OVER 2.5 CONSIGLIATO",
            "motivation": "Elevato volume di xG combinati e trend offensivo registrato nelle ultime uscite."
        }
    ]
    
    os.makedirs("data", exist_ok=True)
    with open("data/matches_analysis.json", "w", encoding="utf-8") as f:
        json.dump(analyzed_matches, f, ensure_ascii=False, indent=4)
    print("File JSON generato con successo.")

if __name__ == "__main__":
    generate_data()
